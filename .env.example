# ==================================
# AI漫剧生产流水线 - 环境配置
# ==================================

# LLM API Keys
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 图像生成 API
KLING_API_KEY=your_kling_api_key_here
KLING_API_SECRET=your_kling_api_secret_here
MIDJOURNEY_API_KEY=your_midjourney_api_key_here

# 配音 API
TTS_PROVIDER=xunfei  # xunfei / elevenlabs
XUNFEI_APP_ID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# 数据库
DATABASE_URL=sqlite:///./data/db.sqlite

# Redis (用于任务队列)
REDIS_URL=redis://localhost:6379/0

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# 默认配置
DEFAULT_LLM_PROVIDER=claude
DEFAULT_IMAGE_PROVIDER=kling
DEFAULT_VIDEO_PROVIDER=kling

# 质量控制
MIN_QUALITY_SCORE=70
AUTO_RETRY_ON_LOW_QUALITY=true
MAX_RETRIES=3
